datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SupportedLocale {
  EN
  RO
  DE
  FR
  IT
  PL
  ES
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  name             String?
  preferredLocale  SupportedLocale   @default(EN)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  businessProfiles BusinessProfile[]
}

model BusinessProfile {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  websiteUrl       String?
  businessModel    String            // B2B_SERVICE, B2B_SAAS, B2C_ECOM, B2C_LOCAL, CREATOR
  industry         String
  geoScope         String            // LOCAL, NATIONAL, GLOBAL
  currentStage     String            // PRE_LAUNCH, TRACTION, GROWTH, ESTABLISHED
  monthlyBudget    Float             @default(0)
  weeklyHours      Int               @default(5)
  ikigai           IkigaiProfile?
  diagnostic       DiagnosticData?
  strategy         StrategyPlan?
  contents         GeneratedContent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model IkigaiProfile {
  id                    String          @id @default(cuid())
  businessProfileId     String          @unique
  businessProfile       BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  locale                SupportedLocale @default(EN)

  // Pillar 1: What You Love / Passion
  p1_time_loss          String?         @db.Text
  p1_spare_time_reading String?         @db.Text
  p1_average_tuesday    String?         @db.Text
  p1_energizing_tasks   String?         @db.Text
  p1_childhood_passions String?         @db.Text
  p1_spark_debates      String?         @db.Text
  p1_creative_outlets   String?         @db.Text

  // Pillar 2: What You Are Good At / Vocation
  p2_effortless_skills  String?         @db.Text
  p2_sought_advice      String?         @db.Text
  p2_hard_skills        String?         @db.Text
  p2_interpersonal_soft String?         @db.Text
  p2_success_patterns   String?         @db.Text
  p2_problem_solving    String?         @db.Text
  p2_recurring_praise   String?         @db.Text

  // Pillar 3: What the World Needs / Mission
  p3_systemic_injustice String?         @db.Text
  p3_community_to_help  String?         @db.Text
  p3_unlimited_resource String?         @db.Text
  p3_immediate_needs    String?         @db.Text
  p3_non_negotiables    String?         @db.Text
  p3_future_gap         String?         @db.Text
  p3_legacy_impact      String?         @db.Text

  // Pillar 4: What You Can Be Paid For / Profession
  p4_past_paid_services String?         @db.Text
  p4_market_paid_skills String?         @db.Text
  p4_commercial_hobbies String?         @db.Text
  p4_high_value_roi     String?         @db.Text
  p4_premium_assets     String?         @db.Text
  p4_growth_niches      String?         @db.Text
  p4_monetization_fit   String?         @db.Text

  // Intersection & Alignment / Synthesis
  overlap_synthesis     String?         @db.Text
  pilot_30_days         String?         @db.Text

  // Positioning Additions
  archetype             String?         @default("VISIONARY_DISRUPTOR")
  coreValues            String[]        @default([])

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model DiagnosticData {
  id                String          @id @default(cuid())
  businessProfileId String          @unique
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  differentiator    String          @db.Text
  competitors       String[]
  marketSaturation  String          // LOW, MEDIUM, HIGH, RED_OCEAN
  viabilityScore    Float
  scoreBreakdown    Json
}

model StrategyPlan {
  id                String          @id @default(cuid())
  businessProfileId String          @unique
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  locale            SupportedLocale @default(EN)
  positioningDoc    String          @db.Text
  contentPillars    Json
  reviewCadence     String          // BIWEEKLY, MONTHLY, QUARTERLY
  activeChannels    String[]
  createdAt         DateTime        @default(now())
}

model GeneratedContent {
  id                String          @id @default(cuid())
  businessProfileId String
  businessProfile   BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  locale            SupportedLocale @default(EN)
  channel           String          // LINKEDIN, FACEBOOK, INSTAGRAM, TIKTOK, EMAIL
  contentType       String          // POST, REEL_SCRIPT, CAROUSEL, NEWSLETTER
  scheduledDate     DateTime?
  hook              String          @db.Text
  bodyContent       String          @db.Text
  visualPrompt      String?         @db.Text
  status            String          @default("DRAFT") // DRAFT, COPIED, PUBLISHED
  createdAt         DateTime        @default(now())
}
